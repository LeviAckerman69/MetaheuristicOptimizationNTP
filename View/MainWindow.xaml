<Window
    x:Class="MetaheuristicOptimizationNTP.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:MetaheuristicOptimizationNTP.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:structures="clr-namespace:MetaheuristicOptimizationNTP.Structures"
    xmlns:viewModel="clr-namespace:MetaheuristicOptimizationNTP.ViewModel"
    Title="Traveling Salesman"
    Width="900"
    Height="600"
    d:DataContext="{d:DesignInstance Type=viewModel:MainViewModel}"
    mc:Ignorable="d">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_User">
                <MenuItem
                    Header="_Register..."
                    Command="{Binding RegisterCommand}" />
                <MenuItem
                    Header="{Binding LoginText}"
                    Command="{Binding LoginCommand}" />
            </MenuItem>
        </Menu>

        <StatusBar
            DockPanel.Dock="Bottom">
            <TextBlock
                Text="{Binding FormatCurrentUser}" />
        </StatusBar>

        <Grid
            DockPanel.Dock="Right"
            Margin="0, 10, 10, 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Command="{Binding OpenConfigurationDialogCommand}"
                Content="Configure..." />

            <Label
                Grid.Row="1"
                Grid.Column="0"
                HorizontalAlignment="Right"
                Content="Size:" />

            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{Binding PopulationSize}" />

            <Button
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Command="{Binding CreatePopulationCommand}"
                Content="Create population" />

            <ListBox
                Grid.Row="3"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                ItemsSource="{Binding Population.Solutions}"
                SelectedItem="{Binding SelectedSolution}"
                SelectionMode="Single">

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type structures:Solution}">
                        <TextBlock Text="{Binding SolutionDescription}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel
                Grid.Row="4"
                        Grid.Column="0" 
                        Grid.ColumnSpan="2"
                Orientation="Horizontal">
            <Button
                IsEnabled="{Binding Population.IsPresent}"
                Command="{Binding StepEvolutionCommand }"
                Content="Step" />

            <Button
                IsEnabled="{Binding Population.IsPresent}"
                Command="{Binding EvolveCommand}"
                Content="{Binding EvolveText}" />
            </StackPanel>
        </Grid>

        <Border
            Margin="10"
            BorderBrush="Black"
            BorderThickness="2">

            <components:TownDisplay
                Margin="20" />
        </Border>

    </DockPanel>
</Window>