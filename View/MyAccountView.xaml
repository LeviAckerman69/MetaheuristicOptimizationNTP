<Window x:Class="MetaheuristicOptimizationNTP.View.MyAccountView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="My account" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="Username:" />
            <TextBox Grid.Column="1" Margin="0,2" VerticalContentAlignment="Center"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
            <Label Grid.Row="1" Content="New password:" />
            <ui:PasswordBox Grid.Row="1" Grid.Column="1" Margin="0,2" PasswordChar="&#x25CF;"
                            Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Label Grid.Row="2" Content="Repeat password:" />
            <ui:PasswordBox Grid.Row="2" Grid.Column="1" Margin="0,2" PasswordChar="&#x25CF;"
                            Password="{Binding RepeatPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <TextBlock Text="Leave both password fields blank to keep your current password."
                   TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0" />
        <DockPanel Margin="0,12,0,0">
            <Button Content="Delete account..." Command="{Binding DeleteAccountCommand}" Padding="8,6" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="80" Padding="8,6" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True"
                        MinWidth="80" Padding="8,6" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
