<Window x:Class="MetaheuristicOptimizationNTP.View.ConfigurationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModel="clr-namespace:MetaheuristicOptimizationNTP.ViewModel"
        d:DataContext="{d:DesignInstance Type=viewModel:ConfigurationDialogViewModel}"
        mc:Ignorable="d"
        Title="Configuration" SizeToContent="WidthAndHeight">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
    </Window.Resources>

    <StackPanel Orientation="Vertical"
                Margin="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Row="0"
                      Grid.Column="0"
                      Header="Crossover algorithms">
                <ItemsControl ItemsSource="{Binding CrossoverOptions}"
                              Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0, 0, 0, 4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBoxGroup" />
                                </Grid.ColumnDefinitions>

                                <Label
                                    Grid.Column="0"
                                    Content="{Binding Name}"
                                    HorizontalContentAlignment="Right"
                                    VerticalContentAlignment="Center" />

                                <CheckBox
                                    Grid.Column="1"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Padding="10, 0, 0, 0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>

            <GroupBox Grid.Row="0"
                      Grid.Column="1"
                      Margin="10, 0, 0, 0"
                      Header="Mutation algorithms">
                <ItemsControl ItemsSource="{Binding MutationOptions}"
                              Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0, 0, 0, 4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBoxGroup" />
                                </Grid.ColumnDefinitions>

                                <Label
                                    Grid.Column="0"
                                    Content="{Binding Name}"
                                    HorizontalContentAlignment="Right"
                                    VerticalContentAlignment="Center" />

                                <CheckBox
                                    Grid.Column="1"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Padding="10, 0, 0, 0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>
        </Grid>
        <StackPanel Margin="0, 10, 0, 0"
                    Orientation="Horizontal">
            <Button Command="{Binding ConfirmCommand}"
                    Content="Confirm" />
            <Button Margin="10, 0, 0, 0"
                    Command="{Binding CancelCommand}"
                    Content="Cancel" />
        </StackPanel>
    </StackPanel>
</Window>