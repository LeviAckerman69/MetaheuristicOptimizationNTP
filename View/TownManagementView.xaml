<Window x:Class="MetaheuristicOptimizationNTP.View.TownManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage towns" Width="520" Height="440"
        MinWidth="420" MinHeight="360" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid ItemsSource="{Binding Towns}" SelectedItem="{Binding SelectedTown}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="150" />
                <DataGridTextColumn Header="X" Binding="{Binding X}" Width="100" />
                <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="Name:" />
            <TextBox Grid.Column="1" Margin="0,2" VerticalContentAlignment="Center"
                     Text="{Binding TownName, UpdateSourceTrigger=PropertyChanged}" />
            <Label Grid.Row="1" Content="X:" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" VerticalContentAlignment="Center"
                     Text="{Binding XText, UpdateSourceTrigger=PropertyChanged}" />
            <Label Grid.Row="2" Content="Y:" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" VerticalContentAlignment="Center"
                     Text="{Binding YText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="Firebrick" TextWrapping="Wrap"
                   Text="{Binding ErrorMessage}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="80" Padding="8,6" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True"
                    MinWidth="80" Padding="8,6" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
