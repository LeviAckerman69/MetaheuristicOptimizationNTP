<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:MetaheuristicOptimizationNTP.ViewModel"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Class="MetaheuristicOptimizationNTP.View.LoginView"
    d:DataContext="{d:DesignInstance Type={x:Type viewModel:LoginViewModel}}"
    mc:Ignorable="d"
    Title="Login" SizeToContent="WidthAndHeight">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinWidth" Value="90" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinWidth" Value="120" />
        </Style>

        <Style TargetType="ui:PasswordBox">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="PasswordChar" Value="&#x25CF;" />
        </Style>
    </Window.Resources>

    <StackPanel
        Orientation="Vertical"
        Margin="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label
                Grid.Column="0"
                Grid.Row="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Content="Username:" />

            <Label
                Grid.Column="0"
                Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Content="Password:" />

            <TextBox
                Grid.Column="1"
                Grid.Row="0"
                VerticalAlignment="Center"
                Text="{Binding Username}" />

            <ui:PasswordBox
                Grid.Column="1"
                Grid.Row="1"
                VerticalAlignment="Center"
                Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        </Grid>
        <StackPanel
            Margin="0, 10, 0, 0"
            Orientation="Horizontal"
            HorizontalAlignment="Right">
            <Button
                Command="{Binding LoginCommand}"
                Content="Login"
                IsDefault="True" />
            <Button
                Margin="10, 0, 0, 0"
                Command="{Binding CancelCommand}"
                Content="Cancel"
                IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>